max_power = 1.0
min_temp = 5
max_temp = 105
control = pid
pid_kp = 73.571
pid_ki = 1.820
pid_kd = 783.849

[verify_heater heater_bed]
max_error = 120
check_gain_time = 40
hysteresis = 5
heating_gain = 2

[fan_generic fan0]
