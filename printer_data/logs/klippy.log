interpolate = true
run_current = 0.58
hold_current = 0.58
sense_resistor = 0.150
uart_address = 3
stealthchop_threshold = 999999

[thermistor my_thermistor_e]
temperature1 = 25
resistance1 = 110000
temperature2 = 100
resistance2 = 7008
temperature3 = 220
resistance3 = 435

[extruder]
