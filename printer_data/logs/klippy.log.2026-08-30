horizontal_move_z = 5
mesh_min = 10,10
mesh_max = 333,340
probe_count = 9,9
algorithm = bicubic
bicubic_tension = 0.4
split_delta_z = 0.016
mesh_pps = 3,3
adaptive_margin = 5
fade_start = 0
fade_end = 10
fade_target = 0

[quad_gantry_level]
