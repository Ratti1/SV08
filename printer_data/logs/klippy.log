x_offset = -17
y_offset = 10
speed = 5.0
samples = 2
sample_retract_dist = 2.0
lift_speed = 50
samples_result = average
samples_tolerance = 0.016
samples_tolerance_retries = 2
z_offset = 2.585

[probe_pressure]
pin = ^!PE12
x_offset = 0
y_offset = 0
z_offset = 0
speed = 1.0

[homing_override]
gcode = 
	{% if not 'Z' in params and not 'Y' in params and 'X' in params %}
	G28 X
	G0 X348 F1200
	{% elif not 'Z' in params and not 'X' in params and 'Y' in params %}
	G28 Y
	G0 Y360  F1200
	{% elif not 'Z' in params and 'X' in params and 'Y' in params %}
	G28 Y
	G0 Y360  F1200
	G4 P2000
	G28 X
	G0 X348  F1200
	{% elif 'Z' in params and not 'X' in params and not 'Y' in params %}
	G90
	G0  X191 Y165 F3600
	G28 Z
	G0  Z10 F600
	{% else %}
	G90
	G0 Z5 F300
	G28 Y
	G0 Y360  F1200
	G4 P2000
	G28 X
	G0 X348  F1200
	G90
	G0  X191 Y165 F3600
	G28 Z
	G0  Z10 F600
	{% endif %}
