	{% for i in range(0, 31) %}
	{% set val = (i / 30.0) ** 2 %}
	SET_PIN PIN=main_led VALUE={val}
	G4 P15
	{% endfor %}

[gcode_macro mainled_off]
gcode = 
	
	{% for i in range(30, -1, -1) %}
	{% set val = (i / 30.0) ** 2 %}
	SET_PIN PIN=main_led VALUE={val}
	G4 P15
	{% endfor %}

