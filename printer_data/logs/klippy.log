command = echo hello world
timeout = 2.
verbose = True

[gcode_macro HELLO_WORLD]
gcode = 
	RUN_SHELL_COMMAND CMD=hello_world

[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32f103xe_34FFDA05334D593528750851-if00
