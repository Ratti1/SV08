shaper_type_x = mzv
shaper_freq_x = 60.4
shaper_type_y = mzv
shaper_freq_y = 41.0

[temperature_sensor mcu_temp]
sensor_type = temperature_mcu
min_temp = 0
max_temp = 100

[temperature_sensor Host_temp]
sensor_type = temperature_host
min_temp = 0
max_temp = 110

[temperature_sensor Toolhead_Temp]
sensor_type = temperature_mcu
sensor_mcu = extra_mcu

[fan_generic fan0]
pin = extra_mcu:PA7
max_power = 1.0

[fan_generic fan1]
pin = extra_mcu:PB0
max_power = 1.0

[temperature_fan CPUfan]
pin = PA1
kick_start_time = 0.5
max_power = 1.0
min_temp = 0
max_temp = 90
hardware_pwm = true
target_temp = 65
sensor_type = temperature_host
max_speed = 1.0
min_speed = 0
control = pid
pid_kp = 2
pid_ki = .5
pid_kd = 0.25
pid_deriv_time = 5.0

[heater_fan hotend_fan]
pin = extra_mcu:PA6
max_power = 1.0
kick_start_time = 0.5
heater = extruder
heater_temp = 45
tachometer_pin = extra_mcu:PA1
tachometer_ppr = 1
tachometer_poll_interval = 0.0013

[display]
lcd_type = uc1701
cs_pin = EXP1_3
a0_pin = EXP1_4
rst_pin = EXP1_5
encoder_pins = ^EXP2_5, ^EXP2_3
click_pin = ^!EXP1_2
contrast = 63
spi_software_miso_pin = EXP2_1
spi_software_mosi_pin = EXP2_6
spi_software_sclk_pin = EXP2_2
display_group = _bootscreen

[output_pin beeper]
pin = EXP1_1
pwm = False
value = 0

[neopixel Screen_Colour]
pin = EXP1_6
chain_count = 3
color_order = RGB
initial_red = 0.12
initial_green = 0.2
initial_blue = 1

[output_pin main_led]
pin = PA3
pwm = True
value = 1
cycle_time = 0.001

[homing_override]
gcode = 
	_LCD_TEMP_MSG MSG="Homing" SEC=5
	{% if not 'Z' in params and not 'Y' in params and 'X' in params %}
	G28 X
	G0 X348 F1200
	{% elif not 'Z' in params and not 'X' in params and 'Y' in params %}
	G28 Y
	G0 Y360  F1200
	{% elif not 'Z' in params and 'X' in params and 'Y' in params %}
	G28 Y
	G0 Y360  F1200
	G4 P2000
	G28 X
	G0 X348  F1200
	{% elif 'Z' in params and not 'X' in params and not 'Y' in params %}
	G90
	G0  X191 Y165 F3600
	G28 Z
	G0  Z10 F600
	{% else %}
	G90
	G0 Z5 F300
	G28 Y
	G0 Y360  F1200
	G4 P2000
	G28 X
	G0 X348  F1200
	G90
	G0  X191 Y165 F3600
	G28 Z
	G0  Z10 F600
	{% endif %}
axes = xyz
set_position_z = 0

[gcode_shell_command get_ip]
command = /home/biqu/get_ip.sh
timeout = 2.
verbose = True

[gcode_macro _GET_IP]
gcode = 
	RUN_SHELL_COMMAND CMD=get_ip

[filament_switch_sensor filament_sensor]
pause_on_runout = True
event_delay = 3.0
pause_delay = 0.5
switch_pin = PE9

