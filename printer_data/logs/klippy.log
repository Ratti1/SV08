	M117 Clean nozzle
	G1 X315 Y360 F9000
	G1 Z0.2 F300
	G1 X352 F4500
	G1 Y360 X324
	G1 Y360 X345
	G1 Y360 X324
	G1 Y360 X345
	G1 Y360 X324
	G1 Y360 X345
	G1 Y360 X324
	G1 Y360 X345
	G1 Y360 X324
	G1 Y360 X325
	G1 Y356 X324 Z5
	G1 Z0.2
	G1 Y360 X324
	G1 Y357 X326
	G1 Y360 X326
	G1 Y357 X328
	G1 Y360 X330
	G1 Y357 X332
