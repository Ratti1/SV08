[display_data _sv08_pro extruder]
position = 0, 0
text = 
	{% set active_extruder = printer.toolhead.extruder %}
	~extruder~
	{"%3.0f" % (printer[active_extruder].temperature)}
	{% if printer[active_extruder].target %}
	~right_arrow~{"%0.0f" % (printer[active_extruder].target)}
	{% else %}
	~degrees~
	{% endif %}

[display_data _sv08_pro z_offset]
position = 0, 10
text = 
	Z:{"%+.2f" % (printer.gcode_move.homing_origin.z)}

[display_data _sv08_pro heater_bed]
position = 1, 0
text = 
	~bed~
	{"%3.0f" % (printer.heater_bed.temperature)}
	{% if printer.heater_bed.target %}
	~right_arrow~{"%0.0f" % (printer.heater_bed.target)}
	{% else %}
	~degrees~
	{% endif %}

[display_data _sv08_pro speed_factor]
position = 1, 10
text = 
	~feedrate~
	{"%3.0f%%" % (printer.gcode_move.speed_factor * 100)}

[display_data _sv08_pro progress_text]
position = 2, 0
text = 
	Prog:{"%3.0f%%" % (printer.display_status.progress * 100)}

[display_data _sv08_pro remaining_time]
position = 2, 10
text = 
	{% if printer.display_status.progress > 0 %}
	{% set total_time = printer.print_stats.print_duration / printer.display_status.progress %}
	{% set rem_time = total_time - printer.print_stats.print_duration %}
	-{"%02d:%02d" % (rem_time // 3600, (rem_time // 60) % 60)}
	{% else %}
	--:--
	{% endif %}

[display_data _sv08_pro print_status]
position = 3, 0
text = 
	{% if printer.display_status.message %}
	{ printer.display_status.message }
	{% elif printer.idle_timeout.state == "Printing" %}
	Printing...
	{% elif printer.extruder.target > 0 or printer.heater_bed.target > 0 %}
	Heating...
	{% else %}
	Ready
	{% endif %}

[delayed_gcode _clear_display_msg]
gcode = 
	M117

